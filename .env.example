# Copy this file to .env and fill in the values. Never commit .env.
# Lines without a value are required. Lines with a value show the default.

# ---------- AWS (S3 data lake and S3 Vectors) ----------
# AWS credentials are found by boto3 itself: either set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY here, or set AWS_PROFILE to a profile from ~/.aws/credentials.
AWS_REGION=
AWS_PROFILE=
S3_BUCKET=
S3_VECTOR_BUCKET=
S3_VECTOR_INDEX=sales-summaries

# ---------- Aiven Kafka ----------
# Always needed: the Service URI (host:port) and the CA certificate in secrets/.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=orders
KAFKA_CONSUMER_GROUP=sales-poc-etl
KAFKA_SSL_CA=secrets/ca.pem
# Login option 1 (used when both are set; works on the Aiven free plan):
# the User and Password from Aiven's connection information.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# Login option 2 (used when username/password are empty): client certificate files.
KAFKA_SSL_CERT=secrets/service.cert
KAFKA_SSL_KEY=secrets/service.key

# ---------- Neo4j AuraDB ----------
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- OpenRouter (LLM) and embeddings ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A model that supports tool calling, as named on openrouter.ai/models
LLM_MODEL=
# openrouter or bedrock (decided in task T1.5)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=
EMBEDDING_DIM=

# ---------- AI agent ----------
AGENT_MAX_STEPS=6

# ---------- Local data and pipelines ----------
DATA_DIR=data
RANDOM_SEED=42
STREAM_BATCH_SIZE=100
STREAM_BATCH_SECONDS=10
